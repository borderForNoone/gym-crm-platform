# Example environment variables for local Docker Compose startup.
# Copy this file to .env and change values if needed:
# cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=gym_db
MYSQL_USER=gym
MYSQL_PASSWORD=gym
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# MongoDB
MONGODB_DATABASE=workload_service
MONGODB_PORT=27017

# ActiveMQ
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin
ACTIVEMQ_PORT=61616
ACTIVEMQ_WEB_PORT=8161

# Application ports
# NOTE: API_GATEWAY_PORT is also used inside the container as server.port,
# so keep it at 8080 unless gateway-service/Dockerfile's EXPOSE is updated too.
DISCOVERY_SERVER_PORT=8761
GYM_CORE_SERVICE_PORT=8081
WORKLOAD_SERVICE_PORT=8082
API_GATEWAY_PORT=8080

# Service hostnames (Docker network aliases, do not change unless you rename services)
MYSQL_HOST=mysql
REDIS_HOST=redis
MONGODB_HOST=mongodb
ACTIVEMQ_HOST=activemq
DISCOVERY_HOST=discovery-server
WORKLOAD_HOST=workload-service

# Security
JWT_SECRET=local-dev-secret-key-local-dev-secret-key
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000